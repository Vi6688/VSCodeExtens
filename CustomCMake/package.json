{
  "name": "custom-cmake-extension",
  "displayName": "Custom CMake Extension",
  "description": "Custom CMake",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.108.1"
  },
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Custom CMake",
      "properties": {
        "CustomCMake.system": {
          "type": "string",
          "default": "build-aarch64",
          "description": "Target system or architecture for the CMake build"
        },
        "CustomCMake.configure": {
          "type": "string",
          "enum": [
            "Debug",
            "Release",
            "RelWithDebInfo",
            "MinSizeRel",
            "Custom"
          ],
          "default": "Release",
          "description": "CMAKE_BUILD_TYPE used when configuring. 'Custom' adds no flag, so put your own in the configure command."
        },
        "CustomCMake.build": {
          "type": "string",
          "default": "Main",
          "description": "CMake target to build (or 'All')"
        },
        "CustomCMake.username": {
          "type": "string",
          "default": "",
          "description": "Username used for build or deployment"
        },
        "CustomCMake.configureCommand": {
          "type": "string",
          "default": "cmake ..",
          "description": "CMake configure command"
        },
        "CustomCMake.hostname": {
          "type": "string",
          "default": "",
          "description": "Target hostname (single selection)"
        },
        "CustomCMake.transfer": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Selected transfer targets: a 5-digit port (uses the hostname), a number (host <hostPrefix><number>), an alias like bsnl154, or user@host."
        },
        "CustomCMake.buildDirectory": {
          "type": "string",
          "default": "build",
          "description": "Build directory, relative to the workspace root"
        },
        "CustomCMake.hostDomain": {
          "type": "string",
          "default": "",
          "description": "Domain appended to the hostname when it contains no dot (e.g. 'gigamesh.live')"
        },
        "CustomCMake.systems": {
          "type": "array",
          "default": [
            "build-aarch64",
            "Linux"
          ],
          "description": "Architectures offered in the picker",
          "items": {
            "type": "string"
          }
        },
        "CustomCMake.hostnames": {
          "type": "array",
          "default": [],
          "description": "Hostnames offered in the picker",
          "items": {
            "type": "string"
          }
        },
        "CustomCMake.transferOptions": {
          "type": "array",
          "default": [],
          "description": "Transfer targets offered in the picker (same formats as 'transfer')",
          "items": {
            "type": "string"
          }
        },
        "CustomCMake.packagePattern": {
          "type": "string",
          "default": "*.ipk",
          "description": "File name pattern of the package sent when the target name contains 'InstallerPackage'"
        },
        "CustomCMake.hostPrefix": {
          "type": "string",
          "default": "gigamesh",
          "description": "Prefix for numeric targets: 154 becomes <prefix>154"
        },
        "CustomCMake.jobs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Parallel build jobs (like make -j). 0 uses one job per CPU core."
        },
        "CustomCMake.saveBeforeBuild": {
          "type": "boolean",
          "default": true,
          "description": "Save all modified files before building"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "CustomCMakeContainer",
          "title": "Custom CMake",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "CustomCMakeContainer": [
        {
          "id": "CustomCMakeSidebar",
          "name": "Custom CMake",
          "initialSize": 8
        },
        {
          "id": "CustomCMakeStop",
          "name": "Running",
          "type": "webview",
          "when": "customCMake.running",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "CustomCMake.selectSystem",
        "title": "Select Architecture",
        "category": "Custom CMake",
        "icon": "$(chip)"
      },
      {
        "command": "CustomCMake.selectConfigure",
        "title": "Select Build Type",
        "category": "Custom CMake",
        "icon": "$(symbol-enum)"
      },
      {
        "command": "CustomCMake.selectBuild",
        "title": "Select Target",
        "category": "Custom CMake",
        "icon": "$(target)"
      },
      {
        "command": "CustomCMake.build",
        "title": "Build",
        "category": "Custom CMake",
        "icon": "$(tools)"
      },
      {
        "command": "CustomCMake.configureBuild",
        "title": "Configure",
        "category": "Custom CMake",
        "icon": "$(gear)"
      },
      {
        "command": "CustomCMake.selectUsername",
        "title": "Select Username",
        "category": "Custom CMake",
        "icon": "$(account)"
      },
      {
        "command": "CustomCMake.selectHostname",
        "title": "Select Hostname",
        "category": "Custom CMake",
        "icon": "$(server)"
      },
      {
        "command": "CustomCMake.transferValue",
        "title": "Select Transfer Number(s)",
        "category": "Custom CMake",
        "icon": "$(plug)"
      },
      {
        "command": "CustomCMake.transfer",
        "title": "Transfer",
        "category": "Custom CMake",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "CustomCMake.runAction",
        "title": "Build and Transfer",
        "category": "Custom CMake",
        "icon": "$(rocket)"
      },
      {
        "command": "CustomCMake.clean",
        "title": "Clean",
        "category": "Custom CMake",
        "icon": "$(trash)"
      },
      {
        "command": "CustomCMake.refreshTargets",
        "title": "Refresh Targets",
        "category": "Custom CMake",
        "icon": "$(refresh)"
      },
      {
        "command": "CustomCMake.openSettings",
        "title": "Open Settings",
        "category": "Custom CMake",
        "icon": "$(settings-gear)"
      },
      {
        "command": "CustomCMake.setPassword",
        "title": "Set Remote Password",
        "category": "Custom CMake",
        "icon": "$(key)"
      },
      {
        "command": "CustomCMake.clearPassword",
        "title": "Clear Remote Password",
        "category": "Custom CMake",
        "icon": "$(trash)"
      },
      {
        "command": "CustomCMake.runInstallAction",
        "title": "Build, Transfer and Install",
        "category": "Custom CMake",
        "icon": "$(package)"
      },
      {
        "command": "CustomCMake.selectJobs",
        "title": "Select Build Threads",
        "category": "Custom CMake",
        "icon": "$(pulse)"
      },
      {
        "command": "CustomCMake.cancel",
        "title": "Stop Running Task",
        "category": "Custom CMake",
        "icon": "$(debug-stop)"
      },
      {
        "command": "CustomCMake.transferInstall",
        "title": "Transfer and Install",
        "category": "Custom CMake",
        "icon": "$(desktop-download)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "CustomCMake.cancel",
          "when": "view == CustomCMakeSidebar && customCMake.running",
          "group": "navigation@0"
        },
        {
          "command": "CustomCMake.configureBuild",
          "when": "view == CustomCMakeSidebar && !customCMake.running",
          "group": "navigation@1"
        },
        {
          "command": "CustomCMake.build",
          "when": "view == CustomCMakeSidebar && !customCMake.running",
          "group": "navigation@2"
        },
        {
          "command": "CustomCMake.runAction",
          "when": "view == CustomCMakeSidebar && !customCMake.running",
          "group": "navigation@3"
        },
        {
          "command": "CustomCMake.refreshTargets",
          "when": "view == CustomCMakeSidebar",
          "group": "1_misc@1"
        },
        {
          "command": "CustomCMake.openSettings",
          "when": "view == CustomCMakeSidebar",
          "group": "1_misc@2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "CustomCMakeSidebar",
        "contents": "Open a folder containing a CMake project to get started.\n[Open Folder](command:vscode.openFolder)"
      }
    ],
    "taskDefinitions": [
      {
        "type": "customcmake"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cmake",
    "build",
    "scp",
    "opkg",
    "embedded"
  ]
}

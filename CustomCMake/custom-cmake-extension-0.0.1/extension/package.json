{
  "name": "custom-cmake-extension",
  "displayName": "Custom CMake Extension",
  "description": "Custom CMake",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.1"
  },
  "activationEvents": [
    "onCommand:CustomCMake.openPanel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Custom CMake",
      "properties": {
        "CustomCMake.system": {
          "type": "string",
          "default": "build-aarch64",
          "description": "Target system or architecture for the CMake build"
        },
        "CustomCMake.folder": {
          "type": "string",
          "default": "builds",
          "description": "Folder name for transfer destination"
        },
        "CustomCMake.configure": {
          "type": "string",
          "enum": [
            "Debug",
            "Release",
            "Custom"
          ],
          "default": "Release",
          "description": "CMake build configuration type"
        },
        "CustomCMake.build": {
          "type": "string",
          "default": "Main",
          "description": "CMake build target name"
        },
        "CustomCMake.username": {
          "type": "string",
          "default": "user",
          "description": "Username used for build or deployment"
        },
        "CustomCMake.configureCommand": {
          "type": "string",
          "default": "cmake ..",
          "description": "CMake configure command"
        },
        "CustomCMake.hostname": {
          "type": "string",
          "default": "hostname1",
          "description": "Target hostname (single selection)"
        },
        "CustomCMake.transfer": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "103"
          ],
          "description": "Transfer numbers (multiple values allowed)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "CustomCMakeContainer",
          "title": "Custom CMake",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "CustomCMakeContainer": [
        {
          "id": "CustomCMakeSidebar",
          "name": "Custom CMake"
        }
      ]
    },
    "commands": [
      {
        "command": "CustomCMake.selectSystem",
        "title": "Select System"
      },
      {
        "command": "CustomCMake.selectConfigure",
        "title": "Select Configure"
      },
      {
        "command": "CustomCMake.selectBuild",
        "title": "Select Build"
      },
      {
        "command": "CustomCMake.build",
        "title": "Build"
      },
      {
        "command": "CustomCMake.configureBuild",
        "title": "Configure & Build"
      },
      {
        "command": "CustomCMake.selectUsername",
        "title": "Select Username"
      },
      {
        "command": "CustomCMake.selectHostname",
        "title": "Select Hostname"
      },
      {
        "command": "CustomCMake.transferValue",
        "title": "Select Transfer Value"
      },
      {
        "command": "CustomCMake.transfer",
        "title": "Transfer"
      },
      {
        "command": "CustomCMake.runAction",
        "title": "Run Action"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  },
  "CustomCMake.build": "Main",
  "CustomCMake.configure": "Release",
  "CustomCMake.hostname": "gigamesh",
  "CustomCMake.system": "build-aarch64",
  "CustomCMake.transfer": [
    "103",
    "104",
    "105"
  ]
}